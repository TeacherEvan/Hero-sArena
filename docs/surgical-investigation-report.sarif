{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Surgical-Investigation",
          "version": "1.1.0",
          "informationUri": "https://github.com/TeacherEvan/Surgical-Investigation",
          "rules": [
            {
              "id": "MISSION-GAP",
              "name": "Mission Gap Finding",
              "shortDescription": { "text": "Stated purpose vs actual implementation divergence" },
              "fullDescription": { "text": "Identified during Step 2 (Mission Verification) of surgical-investigation." },
              "defaultConfiguration": { "level": "warning" }
            },
            {
              "id": "DEPENDENCY-AUDIT",
              "name": "Dependency Audit Finding",
              "shortDescription": { "text": "Dependency version, security vulnerability, or maintenance finding" },
              "fullDescription": { "text": "Found during Step 3 (Dependency Audit) of surgical-investigation." },
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "PRACTICE-REVIEW",
              "name": "Best Practice Assessment",
              "shortDescription": { "text": "Code quality, architecture, testing, security, performance, or docs issue" },
              "fullDescription": { "text": "Found during Step 4 (Engineering Best Practices) of surgical-investigation." },
              "defaultConfiguration": { "level": "warning" }
            },
            {
              "id": "OPTIMALITY-REVIEW",
              "name": "Implementation Optimality Finding",
              "shortDescription": { "text": "Algorithm fit, computational complexity, resource usage, or scalability hotspot" },
              "fullDescription": { "text": "Found during Step 5 (Implementation Optimality Check) of surgical-investigation." },
              "defaultConfiguration": { "level": "note" }
            },
            {
              "id": "AGENT-FILES-REVIEW",
              "name": "Agent Files & Docs Audit Finding",
              "shortDescription": { "text": "Skills, memory, config, docs, or kanban discrepancies" },
              "fullDescription": { "text": "Found during Step 6 (Agent Files Audit) of surgical-investigation." },
              "defaultConfiguration": { "level": "warning" }
            },
            {
              "id": "RESEARCH-FINDING",
              "name": "External Research Finding",
              "shortDescription": { "text": "Strategy-driven finding from external sources with credibility tier" },
              "fullDescription": { "text": "Found during Step 7 (External Source Investigation) of surgical-investigation." },
              "defaultConfiguration": { "level": "note" }
            },
            {
              "id": "RECOMMENDATION",
              "name": "Feature Recommendation",
              "shortDescription": { "text": "Actionable feature recommendation with endpoint or interactive control" },
              "fullDescription": { "text": "Produced during Step 8a (Recommendations) of surgical-investigation." },
              "defaultConfiguration": { "level": "note" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "MISSION-GAP",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Late-game difficulty decays: Weibull wave curve peaks at ~wave 5 then tapers toward zero, contradicting the 'escalating threat' mission."
          },
          "properties": {
            "priority": "high",
            "why": "Late waves get easier instead of harder, undercutting end-run tension. Vampire Survivors maintains pressure via time-based HP scalars (Tier 3: Arcade Artificer); Reddit r/gamedesign flags reverse/decaying curves as bad design (Tier 4).",
            "what": "Add a per-wave HP/damage multiplier scaling with wave number (additive, not compounding); keep 2000 enemy cap as backstop; optional Curse-style difficulty-for-rewards toggle; visible threat-level meter on HUD.",
            "effort": "2-3 days",
            "source": "scripts/core/WaveFormulas.cs:26-51; Arcade Artificer Substack (Tier 3); RoR2 Difficulty (Tier 2); Brotato Wiki Endless Mode (Tier 2)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "scripts/core/WaveFormulas.cs", "uriBaseId": "PROJECTROOT" },
                "region": { "startLine": 26, "startColumn": 1 }
              },
              "message": { "text": "WeibullIntensity curve peaks ~wave 5 then decays" }
            }
          ]
        },
        {
          "ruleId": "MISSION-GAP",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Perk synergies are tags only; 9 perk effects declared but never consumed (HealthRegen, ExplosiveRounds, LifeSteal, CritChance, SlowOnHit, BurnOnHit, FrostAura, ThornArmor, DoubleJump)."
          },
          "properties": {
            "priority": "high",
            "why": "Perks carry SynergyTag but no synergy mechanics exist; dead effects mislead players. Hades' 28 Duo Boons show prerequisite-driven perk pairs create emergent power (Tier 2: TheGamer).",
            "what": "Add 4-6 two-perk synergy triggers with emergent results; gate emergent perks behind two base perks; show synergy hints on perk cards; consume the nine dead effects.",
            "effort": "4-5 days",
            "source": "scripts/core/PerkSystem.cs:13-87; scripts/core/HeroStats.cs:10-29; Hades Duo Boons (Tier 2)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "scripts/core/PerkSystem.cs", "uriBaseId": "PROJECTROOT" },
                "region": { "startLine": 13, "startColumn": 1 }
              },
              "message": { "text": "PerkMeta synergy tags with no synergy mechanics; 9 dead perk effects" }
            }
          ]
        },
        {
          "ruleId": "MISSION-GAP",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "No meta-progression between runs; every run starts from baseline — zero-progress runs."
          },
          "properties": {
            "priority": "medium",
            "why": "Nothing is kept after death, reducing retry motivation. Vampire Survivors' meta-progression eliminates zero-progress runs and drives immediate retries (~2.5x damage / 2x health cumulative; Tier 3: Arcade Artificer).",
            "what": "Award run currency (scrap) kept after death; spend on permanent starting-stat bonuses and hero unlocks in a main-menu node tree; slow tiny-stat egg track; full-respec button.",
            "effort": "5-6 days",
            "source": "Arcade Artificer Substack (Tier 3); Vampire Survivors PowerUp shop (Tier 2); Hades Mirror of Night (Tier 2)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "scripts/ui/MainMenu.cs", "uriBaseId": "PROJECTROOT" },
                "region": { "startLine": 1, "startColumn": 1 }
              },
              "message": { "text": "No meta-progression system exists; each run starts from zero" }
            }
          ]
        },
        {
          "ruleId": "PRACTICE-REVIEW",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "EnemyMutatorSystem.OnThreatChanged is an empty stub — mutators applied once at spawn, never re-applied as threat rises."
          },
          "properties": {
            "priority": "medium",
            "why": "Wastes the threat system's escalation potential; mutators should scale with rising threat (Brotato: +1 elite per 10 waves; Tier 2).",
            "what": "Implement OnThreatChanged to re-apply stacking mutators to live enemies as threat increases (capped per-mutator); un-comment and implement splitting mutator.",
            "effort": "2-3 days",
            "source": "scripts/systems/EnemyMutatorSystem.cs:34-78; Brotato Danger Levels (Tier 2)"
          },
          "locations": [
            {
              "physicalLocation": {
