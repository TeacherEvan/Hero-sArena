<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'ios' ">net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>HeroArena</RootNamespace>
    <!-- Godot.NET.Sdk supplies its own generated AssemblyInfo/TargetFramework
         files under .godot/mono/temp/obj. Leaving the .NET SDK's generation
         on compiles them twice on incremental builds (CS0579); the Godot
         copies already carry the same attributes, so nothing is lost. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude only the xUnit test project; keep GodotTests (CoreSystemTests scene) in the main build -->
    <Compile Remove="tests/HeroArena.Tests/**/*.cs" />
    <!-- Bench harnesses and scratch diagnostics are NOT part of the shipped
         build (see AGENTS.md): they have their own project files and no
         references from game/test code. Keeps dead SceneTree subclasses
         (CheckProcessMode, FrameTimeBenchmark, WaveManagerBenchmark) out of
         the game assembly and the Godot class cache. -->
    <Compile Remove="bench_test/**/*.cs" />
    <Compile Remove="CheckProcessMode.cs" />
    <Compile Remove="FindPhysics.cs" />
    <Compile Remove="FrameTimeBenchmark.cs" />
    <Compile Remove="WaveManagerBenchmark.cs" />
  </ItemGroup>
</Project>
