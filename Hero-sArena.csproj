<Project Sdk="Godot.NET.Sdk/4.3.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'ios' ">net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>HeroArena</RootNamespace>
    <!-- Godot.NET.Sdk supplies its own generated AssemblyInfo/TargetFramework
         files under .godot/mono/temp/obj. Leaving the .NET SDK's generation
         on compiles them twice on incremental builds (CS0579); the Godot
         copies already carry the same attributes, so nothing is lost. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude only the xUnit test project; keep GodotTests (CoreSystemTests scene) in the main build -->
    <Compile Remove="tests/HeroArena.Tests/**/*.cs" />
  </ItemGroup>
</Project>
