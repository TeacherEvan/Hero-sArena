root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
# Repo convention (AGENTS.md): root namespace HeroArena, block-scoped
# namespaces everywhere. These IDE suggestions contradict that convention,
# so they are silenced project-wide. Quality rules (CA*) and Roslynator
# (RCS*) hints stay visible; the enforced gate is
# `dotnet tool run roslynator analyze` in CI.
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0130.severity = none

# CA1016 wants an explicit AssemblyVersion attribute. Godot.NET.Sdk supplies
# assembly info while GenerateAssemblyInfo=false is set in Hero-sArena.csproj
# (re-enabling duplicates the attributes → CS0579; see AGENTS.md), so this
# rule is noise for this project.
dotnet_diagnostic.CA1016.severity = none
